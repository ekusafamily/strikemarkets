  <div class=3D"docs-header">
    <span class=3D"docs-tag"><i class=3D"bi bi-phone"></i> Core API</span>
    <h1>STK Push API</h1>
    <p>Initiate M-Pesa payments directly to your customer's phone. Full API=
 reference with examples.</p>
  </div>

  <div class=3D"docs-content">
    <section>
      <h2>Overview</h2>
      <p class=3D"lead">STK Push initiates a payment request on the custome=
r's phone. The customer receives a popup on their M-Pesa menu to authorize =
the payment.</p>
      <div class=3D"docs-callout info">
        <div class=3D"callout-icon"><i class=3D"bi bi-info-circle-fill"></i=
></div>
        <div class=3D"callout-body">
          <strong>Auto-Features</strong>
          <p>The <code>/mpesa/payment/initiate</code> endpoint automaticall=
y normalizes phone numbers and selects your default payment account. You on=
ly need to provide <code>amount</code>, <code>phone</code>, and optionally =
<code>description</code>.</p>
        </div>
      </div>
    </section>

    <section>
      <h2>Initiate Payment</h2>
      <p class=3D"lead">Send a POST request to initiate an STK Push payment=
:</p>
      <div class=3D"docs-code-block">
        <div class=3D"code-header">
          <span class=3D"code-lang">bash</span>
          <button class=3D"code-copy">Copy</button>
        </div>
        <pre><code>curl -X POST "https://paynexus.co.ke/api/mpesa/payment/i=
nitiate" \
  -H "X-API-Key: sk_your_secret_key_here" \
  -H "Content-Type: application/json" \
  -d '{
    "amount": 100,
    "phone": "0746990866",
    "description": "Order #12345"
  }'</code></pre>
      </div>
      <h3>Request Parameters</h3>
      <div class=3D"docs-table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Field</th>
              <th>Type</th>
              <th>Required</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>amount</code></td>
              <td>integer</td>
              <td style=3D"color:#059652;">Yes</td>
              <td>Payment amount in KES (minimum 1).</td>
            </tr>
            <tr>
              <td><code>phone</code></td>
              <td>string</td>
              <td style=3D"color:#059652;">Yes</td>
              <td>Customer phone number. Auto-normalized (e.g. <code>074699=
0866</code> =E2=86=92 <code>254746990866</code>).</td>
            </tr>
            <tr>
              <td><code>description</code></td>
              <td>string</td>
              <td>No</td>
              <td>Payment description shown to customer.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Response</h2>
      <p class=3D"lead">A successful response returns a <code>checkout_requ=
est_id</code> to track the payment:</p>
      <div class=3D"docs-code-block">
        <div class=3D"code-header"><span class=3D"code-lang">json</span></d=
iv>
        <pre><code>{
  "success": true,
  "data": {
    "reference": "PNXABC123DEF",
    "checkout_request_id": "ws_CO_27012026101718139746990866",
    "amount": 100,
    "phone": "254746990866",
    "status": "initiated"
  }
}</code></pre>
      </div>
    </section>

    <section>
      <h2>Check Payment Status</h2>
      <p class=3D"lead">Check the status of a payment using its reference:<=
/p>
      <div class=3D"docs-code-block">
        <div class=3D"code-header">
          <span class=3D"code-lang">bash</span>
          <button class=3D"code-copy">Copy</button>
        </div>
        <pre><code>curl -X GET "https://paynexus.co.ke/api/payments/PNXABC1=
23DEF" \
  -H "X-API-Key: pk_your_public_key_here"</code></pre>
      </div>
      <p>You can also check status by checkout request ID:</p>
      <div class=3D"docs-code-block">
        <div class=3D"code-header">
          <span class=3D"code-lang">bash</span>
          <button class=3D"code-copy">Copy</button>
        </div>
        <pre><code>curl -X POST "https://paynexus.co.ke/api/payments/status=
-by-checkout-id" \
  -H "X-API-Key: pk_your_public_key_here" \
  -H "Content-Type: application/json" \
  -d '{"checkout_request_id": "ws_CO_27012026101718139746990866"}'</code></=
pre>
      </div>
    </section>

    <section>
      <h2>Validate Phone Number</h2>
      <p class=3D"lead">Validate and normalize phone numbers before initiat=
ing payments:</p>
      <div class=3D"docs-code-block">
        <div class=3D"code-header">
          <span class=3D"code-lang">bash</span>
          <button class=3D"code-copy">Copy</button>
        </div>
        <pre><code>curl -X POST "https://paynexus.co.ke/api/mpesa/validate-=
phone" \
  -H "X-API-Key: pk_your_public_key_here" \
  -H "Content-Type: application/json" \
  -d '{"phone": "0746990866"}'</code></pre>
      </div>
      <div class=3D"docs-code-block">
        <div class=3D"code-header"><span class=3D"code-lang">json</span></d=
iv>
        <pre><code>{
  "success": true,
  "data": {
    "original": "0746990866",
    "normalized": "254746990866",
    "valid": true,
    "provider": "mpesa"
  }
}</code></pre>
      </div>
    </section>

    <section>
      <h2>Status Values</h2>
      <div class=3D"docs-table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Status</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><code>initiated</code></td><td>STK Push sent to custome=
r's phone</td></tr>
            <tr><td><code>processing</code></td><td>Payment is being proces=
sed</td></tr>
            <tr><td><code>completed</code></td><td>Payment successful</td><=
/tr>
            <tr><td><code>failed</code></td><td>Payment failed</td></tr>
            <tr><td><code>cancelled</code></td><td>Customer cancelled the r=
equest</td></tr>
            <tr><td><code>expired</code></td><td>STK Push request expired</=
td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Code Examples</h2>
      <div class=3D"docs-tabs">
        <div class=3D"tab-nav">
          <button class=3D"tab-btn active">Node.js</button>
          <button class=3D"tab-btn">PHP</button>
          <button class=3D"tab-btn">Python</button>
        </div>
        <div class=3D"tab-panel active" id=3D"tab-node">
          <div class=3D"docs-code-block">
            <div class=3D"code-header">
              <span class=3D"code-lang">javascript</span>
              <button class=3D"code-copy">Copy</button>
            </div>
            <pre><code>const axios =3D require('axios');

const client =3D axios.create({
  baseURL: 'https://paynexus.co.ke/api',
  headers: { 'X-API-Key': 'sk_your_secret_key_here' }
});

async function initiatePayment() {
  const response =3D await client.post('/mpesa/payment/initiate', {
    amount: 100,
    phone: '0746990866',
    description: 'Order #12345'
  });
  console.log(response.data);
}

initiatePayment();</code></pre>
          </div>
        </div>
        <div class=3D"tab-panel" id=3D"tab-php">
          <div class=3D"docs-code-block">
            <div class=3D"code-header">
              <span class=3D"code-lang">php</span>
              <button class=3D"code-copy">Copy</button>
            </div>
            <pre><code>$ch =3D curl_init();

curl_setopt_array($ch, [
  CURLOPT_URL =3D&gt; 'https://paynexus.co.ke/api/mpesa/payment/initiate',
  CURLOPT_RETURNTRANSFER =3D&gt; true,
  CURLOPT_HTTPHEADER =3D&gt; [
    'X-API-Key: sk_your_secret_key_here',
    'Content-Type: application/json'
  ],
  CURLOPT_POST =3D&gt; true,
  CURLOPT_POSTFIELDS =3D&gt; json_encode([
    'amount' =3D&gt; 100,
    'phone' =3D&gt; '0746990866',
    'description' =3D&gt; 'Order #12345'
  ])
]);

$response =3D curl_exec($ch);
$payment =3D json_decode($response, true);
echo $payment['data']['reference'];</code></pre>
          </div>
        </div>
        <div class=3D"tab-panel" id=3D"tab-python">
          <div class=3D"docs-code-block">
            <div class=3D"code-header">
              <span class=3D"code-lang">python</span>
              <button class=3D"code-copy">Copy</button>
            </div>
            <pre><code>import requests

response =3D requests.post(
    'https://paynexus.co.ke/api/mpesa/payment/initiate',
    headers=3D{'X-API-Key': 'sk_your_secret_key_here'},
    json=3D{
        'amount': 100,
        'phone': '0746990866',
        'description': 'Order #12345'
    }
)

print(response.json())</code></pre>
          </div>
        </div>
      </div>
    </section>

